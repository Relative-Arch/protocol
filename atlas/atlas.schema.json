{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relative Architecture Atlas",
  "description": "JSON Schema for validating atlas.json files conforming to the Relative Architecture Protocol v1.0",
  "type": "object",
  "required": ["protocol", "version", "axes", "rules"],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "Relative Architecture"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "author": {
      "type": "string"
    },
    "contact": {
      "type": "string",
      "format": "email"
    },
    "web": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "axes": {
      "type": "object",
      "required": ["Z", "Y", "X", "W"],
      "properties": {
        "Z": { "$ref": "#/definitions/axis" },
        "Y": { "$ref": "#/definitions/axis" },
        "X": { "$ref": "#/definitions/axis" },
        "W": { "$ref": "#/definitions/axis" }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "synchronization": { "type": "object" },
        "field_separation": { "type": "string" },
        "transition_pattern": { "type": "string" },
        "weak_link": { "type": "string" }
      }
    },
    "zones": {
      "type": "object"
    }
  },
  "definitions": {
    "axis": {
      "type": "object",
      "required": ["name", "description", "dimensions"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "dimensions": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 3,
          "patternProperties": {
            "^[ZYXW][1-3]$": { "$ref": "#/definitions/dimension" }
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name", "aspect", "levels"],
      "properties": {
        "name": { "type": "string" },
        "aspect": {
          "type": "string",
          "enum": ["topology", "state", "dynamics"]
        },
        "levels": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4"],
          "properties": {
            "0": { "type": "string" },
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" }
          }
        }
      }
    }
  }
      }
