{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relative Architecture Atlas",
  "description": "JSON Schema for validating atlas.json files conforming to the Relative Architecture Protocol v1.1",
  "type": "object",
  "required": ["protocol", "version", "spec_compatibility", "canonical_url", "axes", "rules", "zones"],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "Relative Architecture"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "spec_compatibility": {
      "type": "string",
      "description": "Version of the data format this file is compatible with"
    },
    "author": {
      "type": "string"
    },
    "contact": {
      "type": "string",
      "format": "email"
    },
    "web": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "changelog_note": {
      "type": "string",
      "description": "Human-readable note on what changed in this version"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL of the GitHub Release for this protocol version"
    },
    "axes": {
      "type": "object",
      "required": ["Z", "Y", "X", "W"],
      "properties": {
        "Z": { "$ref": "#/definitions/axis" },
        "Y": { "$ref": "#/definitions/axis" },
        "X": { "$ref": "#/definitions/axis" },
        "W": { "$ref": "#/definitions/axis" }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "synchronization": { "type": "object" },
        "field_separation": { "type": "string" },
        "transition_pattern": { "type": "string" },
        "weak_link": { "type": "string" }
      }
    },
    "zones": {
      "type": "object"
    }
  },
  "definitions": {
    "axis": {
      "type": "object",
      "required": ["name", "description", "dimensions"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "dimensions": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 3,
          "patternProperties": {
            "^[ZYXW][1-3]$": { "$ref": "#/definitions/dimension" }
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name", "aspect", "levels"],
      "properties": {
        "name": { "type": "string" },
        "aspect": {
          "type": "string",
          "enum": ["topology", "state", "dynamics"]
        },
        "levels": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4"],
          "properties": {
            "0": { "type": "string" },
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" }
          }
        }
      }
    }
  }
}
